{
  "compilerOptions": {
    "types": ["bun"],
    "target": "esnext",
    "module": "esnext",
    "lib": ["DOM", "ESNext"],
    "strict": false,
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "vite/**/*.ts", "tests/**/*.ts"]
}
