{
  "name": "voice-over-translation",
  "version": "1.0.0",
  "author": "Toil",
  "license": "MIT",
  "description": "A small extension that adds a Yandex Browser video translation to other browsers",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyhalight/voice-over-translation.git"
  },
  "keywords": [
    "cli",
    "vot",
    "voice-over-translation"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@chromatic-com/storybook": "latest",
    "@crxjs/vite-plugin": "^2.7.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-styling-webpack": "^3.0.2",
    "@storybook/addon-vitest": "^10.5.8",
    "@toil/translate": "^1.10.0",
    "@types/bun": "^1.3.14",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "lefthook": "^2.1.10",
    "npm-run-all2": "^9.0.3",
    "playwright": "latest",
    "sass": "^1.102.0",
    "storybook": "^10.5.8",
    "storybook-solidjs-vite": "latest",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "latest",
    "zip-a-folder": "^6.1.3"
  },
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test",
    "test:unit:watch": "bun test --watch",
    "test:ui": "vite build --config vite/vite.test-ui.config.ts",
    "build:gm:default": "vite build --config vite/vite.config.ts",
    "build:gm:min": "vite build --mode minify --config vite/vite.config.ts",
    "build:gm": "run-p build:gm:default build:gm:min",
    "build:ext": "run-p build:chrome build:firefox",
    "build:chrome": "vite build --config vite/vite.extension.crxjs.config.ts",
    "build:firefox": "vite build --config vite/vite.extension.config.ts",
    "build:dev": "vite build --mode development --config vite/vite.config.ts",
    "dev": "vite build --watch --mode development --config vite/vite.config.ts",
    "format": "bunx @biomejs/biome check --write --unsafe ./src ./vite ./scripts",
    "lint": "bunx @biomejs/biome lint ./src ./vite ./scripts",
    "check": "bunx tsc --noEmit && bunx tsc -p src/tsconfig.json --noEmit",
    "gen:wiki": "bun run ./scripts/wiki-gen/index.js",
    "autobuild": "bun run ./scripts/autobuild.ts",
    "zip:source": "bun ./scripts/zip/get-source.ts",
    "localize": "bunx \"@toil/localize-tui\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@toil/gm-types": "^1.0.5",
    "@vot.js/core": "^3.0.2",
    "@vot.js/ext": "^3.0.2",
    "@vot.js/shared": "^3.0.2",
    "bowser": "^2.14.1",
    "chaimu": "^1.1.0",
    "solid-js": "^1.9.14"
  }
}
