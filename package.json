{
  "name": "voice-over-translation",
  "version": "1.0.0",
  "author": "Toil",
  "license": "MIT",
  "description": "Watch videos in other languages with voice-over translation and subtitles in any browser",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyhalight/voice-over-translation.git"
  },
  "keywords": [
    "cli",
    "vot",
    "voice-over-translation"
  ],
  "imports": {
    "#modules/*": "./src/modules/*",
    "#core/*": "./src/core/*",
    "#utils/*": "./src/utils/*",
    "#types/*": "./src/types/*",
    "#config/*": "./src/config/*",
    "#stores/*": "./src/stores/*",
    "#components/*": "./src/components/*",
    "#extension/*": "./src/extension/*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@toil/translate": "^1.10.0",
    "@types/bun": "^1.4.4",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@wxt-dev/module-solid": "^1.1.4",
    "lefthook": "^2.2.2",
    "npm-run-all2": "^9.0.4",
    "playwright": "^1.64.1",
    "sass": "^1.106.1",
    "storybook": "^10.6.3",
    "storybook-solidjs-vite": "^10.7.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4",
    "zip-a-folder": "^7.0.1"
  },
  "scripts": {
    "test": "bun test --isolate --preload ./tests/setup.ts",
    "test:unit": "bun run test",
    "test:unit:watch": "bun test --isolate --preload ./tests/setup.ts --watch",
    "test:ui": "vitest run --project storybook --maxWorkers=4",
    "build:gm:default": "vite build --config vite/vite.config.ts",
    "build:gm:min": "vite build --mode minify --config vite/vite.config.ts",
    "build:gm": "run-p build:gm:default build:gm:min",
    "build:ext": "run-s build:chrome build:firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:dev": "vite build --mode development --config vite/vite.config.ts",
    "dev:gm": "vite build --watch --mode development --config vite/vite.config.ts",
    "format": "bunx @biomejs/biome check --write --unsafe ./src ./vite ./scripts",
    "lint": "bunx @biomejs/biome lint ./src ./vite ./scripts",
    "check": "bunx tsc -p ./src/tsconfig.json --noEmit",
    "gen:wiki": "bun run ./scripts/wiki-gen/index.js",
    "autobuild": "bun run ./scripts/autobuild.ts",
    "autobuild:signed": "SIGN_FIREFOX=true bun run ./scripts/autobuild.ts",
    "sign:firefox": "bun run ./scripts/output/sign-firefox.ts",
    "zip:source": "bun ./scripts/output/zip-source.ts",
    "localize": "bunx \"@toil/localize-tui\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postinstall": "wxt prepare",
    "dev:ext": "wxt",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build:ext:debug": "run-s \"build:chrome -- --mode development\" \"build:firefox -- --mode development\"",
    "zip:ext": "wxt zip && wxt zip -b firefox",
    "dev": "wxt"
  },
  "dependencies": {
    "@toil/gm-types": "^1.0.6",
    "@vot.js/core": "^3.2.0",
    "@vot.js/ext": "^3.2.0",
    "@vot.js/shared": "^3.2.0",
    "astring": "1.9.0",
    "bowser": "^2.14.1",
    "chaimu": "^1.1.0",
    "googlevideo": "^5.0.1",
    "meriyah": "7.4.0",
    "solid-js": "^1.9.17",
    "web-ext": "^10.8.0"
  }
}
