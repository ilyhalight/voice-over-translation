{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    ".storybook/**",
    // bundle
    "dist/**",
    "dist-ext/**",
    ".output/**",
    // autogenerated file
    "./src/types/localization.ts"
  ],
  "ignoreDependencies": ["@storybook/addon-a11y", "@storybook/addon-docs"],
  "dynamicallyLoaded": ["src/extension/**/*.ts", "src/shims/nodeCrypto.ts"],
  "rules": {
    "unused-export": "warn",
    // many false-positive detections with this rule
    "unused-class-member": "off"
  }
}
